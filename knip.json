{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "run.mjs",
    "prep-workdir.mjs",
    "models.mjs",
    "vendor.mjs",
    "vendor.selftest.mjs",
    "extensions/*/extension.mjs",
    "extensions/*/selftest.mjs"
